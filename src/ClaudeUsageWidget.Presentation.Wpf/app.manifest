<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Same level the SDK's default manifest asks for: the widget never needs elevation. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!--
    Declaring Windows 10 support is what lets a window be both a child and layered. Without
    it Windows treats the process as pre-Windows 8, where a layered window cannot be a child,
    and the widget's per-pixel transparent child window of the taskbar cannot be created.
  -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!--
    Per-monitor v2, the awareness Explorer runs with. The widget is a child of the taskbar,
    and the taskbar's rectangles are only in the same pixels as ours when both processes
    agree on the DPI awareness: otherwise Windows scales coordinates in between and the
    widget lands in the wrong place on any display that is not at 100%.
    The legacy dpiAware element is the fallback for versions that predate dpiAwareness.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
