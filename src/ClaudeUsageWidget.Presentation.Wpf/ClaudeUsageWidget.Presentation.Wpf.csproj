<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WidgetWindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Solo por NotifyIcon, el icono del area de notificacion: WPF no tiene uno propio. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClaudeUsageWidget</AssemblyName>
    <RootNamespace>ClaudeUsageWidget.Presentation.Wpf</RootNamespace>
    <ApplicationIcon>Assets\Icons\ClaudeUsageWidget.ico</ApplicationIcon>
    <!-- Apagado solo aqui: el codigo generado por XAML no esta bajo nuestro control. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    UseWindowsForms agrega estos using globales, y chocan con WPF en nombres como
    MessageBox, Application o Color. WinForms se usa con alias solo donde hace falta.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\ClaudeUsageWidget.ico" />
    <Resource Include="Assets\Fonts\Montserrat-Medium.ttf" />
    <None Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeUsageWidget.Application\ClaudeUsageWidget.Application.csproj" />
    <ProjectReference Include="..\ClaudeUsageWidget.Domain\ClaudeUsageWidget.Domain.csproj" />
    <ProjectReference Include="..\ClaudeUsageWidget.Infrastructure\ClaudeUsageWidget.Infrastructure.csproj" />
  </ItemGroup>
</Project>
