<Window x:Class="ClaudeUsageWidget.Presentation.Wpf.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClaudeUsageWidget.Presentation.Wpf.Controls"
        Title="Claude usage"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Width="{StaticResource WidgetWidth}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <!--
            Sin marco del sistema no hay bordes que agarrar. WindowChrome le devuelve a Windows
            una franja invisible alrededor de la superficie para redimensionar desde cualquier
            lado o esquina. CaptionHeight en 0: mover la ventana sigue siendo cosa de DragMove.
        -->
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="{StaticResource ResizeBorderThickness}"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.ContextMenu>
        <ContextMenu>
            <!--
                Un ContextMenu no vive en el arbol visual de su ventana, asi que
                RelativeSource AncestorType=Window no encuentra nada. El puente es
                PlacementTarget, que si apunta al elemento que abrio el menu.
            -->
            <MenuItem Header="Siempre visible"
                      IsCheckable="True"
                      IsChecked="{Binding PlacementTarget.Topmost, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=TwoWay}" />
            <MenuItem Header="Restablecer tamaño" Click="OnResetSizeRequested" />
            <Separator />
            <!-- Oculta al area de notificacion; el icono de ahi la vuelve a mostrar. -->
            <MenuItem Header="Ocultar" Click="OnHideRequested" />
            <MenuItem Header="Salir" Click="OnCloseRequested" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="Surface"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="{StaticResource SurfaceCornerRadius}"
            Padding="{StaticResource SurfacePadding}"
            MouseLeftButtonDown="OnSurfaceDragStarted">

        <!-- La escala la fija el code-behind a partir del tamano de la ventana. -->
        <Border.LayoutTransform>
            <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>

        <!--
            Las filas van en una fila Auto porque el Grid la mide sin limite de alto: asi
            Rows.DesiredSize es siempre el alto natural. Medidas directamente por el Border,
            WPF recortaria ese valor al espacio disponible y el zoom se retroalimentaria,
            encogiendo la ventana en cada cambio. Las filas * reparten el aire sobrante.
        -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="Rows" Grid.Row="1">

                <controls:UsageBar Fraction="{Binding FiveHour.Fraction}"
                                   ResetLabel="{Binding FiveHour.ResetLabel}"
                                   PercentLabel="{Binding FiveHour.PercentLabel}"
                                   IsAlerting="{Binding FiveHour.IsAlerting}"
                                   AccentBrush="{StaticResource FiveHourAccentBrush}"
                                   AlertBrush="{StaticResource AlertAccentBrush}"
                                   TrackBrush="{StaticResource TrackBrush}"
                                   LabelBrush="{StaticResource LabelBrush}"
                                   LabelFontFamily="{StaticResource WidgetFontFamily}"
                                   LabelFontSize="{StaticResource LabelFontSize}"
                                   BarHeight="{StaticResource BarHeight}"
                                   BarCornerRadius="{StaticResource BarCornerRadius}"
                                   LabelSpacing="{StaticResource BarToLabelSpacing}" />

                <controls:UsageBar Margin="{StaticResource BetweenRowsSpacing}"
                                   Fraction="{Binding SevenDay.Fraction}"
                                   ResetLabel="{Binding SevenDay.ResetLabel}"
                                   PercentLabel="{Binding SevenDay.PercentLabel}"
                                   IsAlerting="{Binding SevenDay.IsAlerting}"
                                   AccentBrush="{StaticResource SevenDayAccentBrush}"
                                   AlertBrush="{StaticResource AlertAccentBrush}"
                                   TrackBrush="{StaticResource TrackBrush}"
                                   LabelBrush="{StaticResource LabelBrush}"
                                   LabelFontFamily="{StaticResource WidgetFontFamily}"
                                   LabelFontSize="{StaticResource LabelFontSize}"
                                   BarHeight="{StaticResource BarHeight}"
                                   BarCornerRadius="{StaticResource BarCornerRadius}"
                                   LabelSpacing="{StaticResource BarToLabelSpacing}" />

            </StackPanel>
        </Grid>
    </Border>
</Window>
