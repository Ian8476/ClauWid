<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutrals for a light taskbar. Same keys as TaskbarDark.xaml. -->
    <SolidColorBrush x:Key="LabelBrush" Color="#FF1B1C1F" />
    <SolidColorBrush x:Key="PercentLabelBrush" Color="#FF4A4D55" />
    <SolidColorBrush x:Key="TrackBrush" Color="#26000000" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#FF4A4D55" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#0A000000" />

</ResourceDictionary>
