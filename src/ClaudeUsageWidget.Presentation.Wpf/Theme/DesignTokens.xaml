<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Everything that does not depend on the taskbar being dark or light. The neutrals that
        do (labels, track, button states) live in TaskbarDark.xaml and TaskbarLight.xaml.
    -->

    <!--
        One fill color per severity band, shared by both bars. The thresholds that pick the
        band live in UsageSeverityPolicy: 0-50% low, 50-70% moderate, 70-85% high, 85%+ critical.
        Blue and yellow come from the mockup; orange and red match their saturation and lightness.
    -->
    <Color x:Key="LowUsageColor">#FF409FF8</Color>
    <Color x:Key="ModerateUsageColor">#FFF8D659</Color>
    <Color x:Key="HighUsageColor">#FFF79845</Color>
    <Color x:Key="CriticalUsageColor">#FFF4554E</Color>

    <SolidColorBrush x:Key="LowUsageBrush" Color="{StaticResource LowUsageColor}" />
    <SolidColorBrush x:Key="ModerateUsageBrush" Color="{StaticResource ModerateUsageColor}" />
    <SolidColorBrush x:Key="HighUsageBrush" Color="{StaticResource HighUsageColor}" />
    <SolidColorBrush x:Key="CriticalUsageBrush" Color="{StaticResource CriticalUsageColor}" />

    <!--
        The widget has no surface of its own: the taskbar shows through. A fully transparent
        pixel of a layered window lets the mouse through to whatever is underneath, so the
        slot is painted with the faintest alpha there is. It looks the same and makes the
        whole slot answer to the mouse, gaps between the labels included.
    -->
    <SolidColorBrush x:Key="HitSurfaceBrush" Color="#01000000" />

    <!--
        Montserrat Medium is embedded. The file declares family "Montserrat" with weight
        Medium, so the weight is requested explicitly: that selects the face by name instead
        of relying on WPF's nearest-weight fallback.
    -->
    <FontFamily x:Key="WidgetFontFamily">pack://application:,,,/Assets/Fonts/#Montserrat</FontFamily>
    <FontWeight x:Key="LabelFontWeight">Medium</FontWeight>
    <sys:Double x:Key="LabelFontSize">10.5</sys:Double>

    <!--
        The slot is laid out for the standard 48-unit taskbar and scaled as a whole when the
        real one is thicker or thinner: two thin bars under small labels, then the button.
    -->
    <sys:Double x:Key="TaskbarSlotWidth">198</sys:Double>
    <sys:Double x:Key="TaskbarSlotHeight">48</sys:Double>
    <Thickness x:Key="TaskbarSlotPadding">10,0,6,0</Thickness>
    <sys:Double x:Key="BarHeight">3</sys:Double>
    <CornerRadius x:Key="BarCornerRadius">1.5</CornerRadius>
    <Thickness x:Key="LabelToBarSpacing">0,0,0,2</Thickness>
    <Thickness x:Key="BetweenRowsSpacing">0,4,0,0</Thickness>

    <!-- Segoe Fluent Icons ships with Windows 11; Windows 10 has the same glyph in MDL2. -->
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:String x:Key="RefreshGlyph">&#xE72C;</sys:String>
    <sys:Double x:Key="RefreshGlyphSize">12</sys:Double>
    <sys:Double x:Key="RefreshButtonSize">28</sys:Double>
    <CornerRadius x:Key="RefreshButtonCornerRadius">4</CornerRadius>
    <Thickness x:Key="RefreshButtonMargin">8,0,0,0</Thickness>

    <!-- One turn of the icon while a refresh is in flight, and how fast it settles afterwards. -->
    <Duration x:Key="RefreshSpinDuration">0:0:0.6</Duration>
    <Duration x:Key="RefreshSettleDuration">0:0:0.2</Duration>

</ResourceDictionary>
