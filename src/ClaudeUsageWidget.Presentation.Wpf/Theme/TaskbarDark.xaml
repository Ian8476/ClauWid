<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Neutrals for a dark taskbar. The track and the button states are translucent because
        the taskbar behind them is: an opaque gray would read as a block on top of it.
        TaskbarLight.xaml defines the same keys.
    -->
    <SolidColorBrush x:Key="LabelBrush" Color="#FFF2F3F5" />
    <SolidColorBrush x:Key="PercentLabelBrush" Color="#FFC9CCD4" />
    <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#FFC9CCD4" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#0DFFFFFF" />

</ResourceDictionary>
