<UserControl x:Class="ClaudeUsageWidget.Presentation.Wpf.Controls.TaskbarWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ClaudeUsageWidget.Presentation.Wpf.Controls"
             xmlns:converters="clr-namespace:ClaudeUsageWidget.Presentation.Wpf.Converters"
             MouseRightButtonUp="OnMouseRightButtonUp"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Grayscale"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--
                The tokens are merged here instead of in App.xaml so the view carries
                everything it needs. The code-behind adds TaskbarDark or TaskbarLight next to
                them and swaps it when the Windows mode changes, which is why the neutrals
                below are DynamicResource.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:UsageSeverityBrushConverter x:Key="SeverityBrushConverter"
                                                    LowBrush="{StaticResource LowUsageBrush}"
                                                    ModerateBrush="{StaticResource ModerateUsageBrush}"
                                                    HighBrush="{StaticResource HighUsageBrush}"
                                                    CriticalBrush="{StaticResource CriticalUsageBrush}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="Slot"
            Width="{StaticResource TaskbarSlotWidth}"
            Height="{StaticResource TaskbarSlotHeight}"
            Padding="{StaticResource TaskbarSlotPadding}"
            Background="{StaticResource HitSurfaceBrush}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">

        <!-- The code-behind sets the zoom from the thickness of the real taskbar. -->
        <Border.LayoutTransform>
            <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">

                <controls:UsageBar Fraction="{Binding FiveHour.Fraction}"
                                   ResetLabel="{Binding FiveHour.ResetLabel}"
                                   PercentLabel="{Binding FiveHour.PercentLabel}"
                                   FillBrush="{Binding FiveHour.Severity, Converter={StaticResource SeverityBrushConverter}}"
                                   TrackBrush="{DynamicResource TrackBrush}"
                                   LabelBrush="{DynamicResource LabelBrush}"
                                   PercentLabelBrush="{DynamicResource PercentLabelBrush}"
                                   LabelFontFamily="{StaticResource WidgetFontFamily}"
                                   LabelFontSize="{StaticResource LabelFontSize}"
                                   LabelFontWeight="{StaticResource LabelFontWeight}"
                                   BarHeight="{StaticResource BarHeight}"
                                   BarCornerRadius="{StaticResource BarCornerRadius}"
                                   LabelSpacing="{StaticResource LabelToBarSpacing}" />

                <controls:UsageBar Margin="{StaticResource BetweenRowsSpacing}"
                                   Fraction="{Binding SevenDay.Fraction}"
                                   ResetLabel="{Binding SevenDay.ResetLabel}"
                                   PercentLabel="{Binding SevenDay.PercentLabel}"
                                   FillBrush="{Binding SevenDay.Severity, Converter={StaticResource SeverityBrushConverter}}"
                                   TrackBrush="{DynamicResource TrackBrush}"
                                   LabelBrush="{DynamicResource LabelBrush}"
                                   PercentLabelBrush="{DynamicResource PercentLabelBrush}"
                                   LabelFontFamily="{StaticResource WidgetFontFamily}"
                                   LabelFontSize="{StaticResource LabelFontSize}"
                                   LabelFontWeight="{StaticResource LabelFontWeight}"
                                   BarHeight="{StaticResource BarHeight}"
                                   BarCornerRadius="{StaticResource BarCornerRadius}"
                                   LabelSpacing="{StaticResource LabelToBarSpacing}" />

            </StackPanel>

            <Button Grid.Column="1"
                    Width="{StaticResource RefreshButtonSize}"
                    Height="{StaticResource RefreshButtonSize}"
                    Margin="{StaticResource RefreshButtonMargin}"
                    VerticalAlignment="Center"
                    Focusable="False"
                    ToolTip="Actualizar ahora"
                    Click="OnRefreshRequested">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate"
                                Background="Transparent"
                                CornerRadius="{StaticResource RefreshButtonCornerRadius}">
                            <TextBlock x:Name="Glyph"
                                       Text="{StaticResource RefreshGlyph}"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="{StaticResource RefreshGlyphSize}"
                                       Foreground="{DynamicResource GlyphBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>

                            <!--
                                The icon turns for as long as the refresh is in flight. When it
                                lands, the turn in progress is completed instead of cut: 360
                                degrees looks like 0, so the next refresh starts clean.
                            -->
                            <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glyph"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0"
                                                             To="360"
                                                             Duration="{StaticResource RefreshSpinDuration}"
                                                             RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glyph"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             To="360"
                                                             Duration="{StaticResource RefreshSettleDuration}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
